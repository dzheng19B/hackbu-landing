{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/schedule/",
      "destination": "/schedule.html"
    },
    {
      "source": "/sponsors",
      "destination": "/sponsors.html"
    },
    {
      "source": "/sponsors/",
      "destination": "/sponsors.html"
    },
    {
      "source": "/hackathons",
      "destination": "/hackathons.html"
    },
    {
      "source": "/hackathons/",
      "destination": "/hackathons.html"
    },
    {
      "source": "/components",
      "destination": "/components.html"
    },
    {
      "source": "/components/",
      "destination": "/components.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/artwork/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
